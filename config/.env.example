# ~/.openclaw/.env — MACHINE-LOCAL, NOT tracked by Git
# Copy this template to ~/.openclaw/.env and fill in your actual values.
# OpenClaw reads this file automatically from that path.
#
# NEVER place this file inside the Git repository.
# NEVER commit your real tokens or API keys.

# ── AI Model provider ───────────────────────────────────────────────────────
# The model ref used in config (provider/model-name format)
OPENCLAW_MODEL_PRIMARY=anthropic/claude-sonnet-4-6
# OPENCLAW_MODEL_FALLBACK=openai/gpt-4o

# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── OpenAI (optional) ───────────────────────────────────────────────────────
# OPENAI_API_KEY=your-openai-api-key-here

# ── Telegram Bot ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your numeric Telegram user ID (not username).
# Find it: DM your bot, run 'openclaw logs --follow', read 'from.id'.
# Used for dmPolicy: "allowlist" -> allowFrom.
TELEGRAM_OWNER_ID=your-numeric-telegram-user-id-here

# ── GitHub (optional, for future Git/PR capabilities) ───────────────────────
# GITHUB_TOKEN=your-github-personal-access-token-here
